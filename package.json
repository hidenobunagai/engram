{
  "name": "engram",
  "version": "0.4.0",
  "description": "Automatic working memory for data analysts in Claude Code, with optional team sharing",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile dist/cli.mjs",
    "test": "bun run build && bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@types/node": "^22.10.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
